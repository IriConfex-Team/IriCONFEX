POSTGRES_USER=iriconfex
POSTGRES_PASSWORD=cambie_esta_clave
POSTGRES_DB=iriconfex
DATABASE_URL=postgresql://iriconfex:cambie_esta_clave@localhost:5432/iriconfex
DIRECT_URL=postgresql://iriconfex:cambie_esta_clave@localhost:5432/iriconfex
PORT=3000
# Orígenes permitidos por CORS, separados por coma, sin "/" final.
# Local: la web de Vite. Producción: la URL de Vercel (https://...).
CORS_ORIGINS=http://localhost:5173
# Ruta del pijamas.json que usa la API (relativa a la carpeta api/)
RUTA_CONFIG=../datos/categorias/pijamas.json
# Solo si el pijamas.json no trae el bloque "negocio" con el WhatsApp (8 dígitos)
WHATSAPP_NEGOCIO=
# URL pública de la API en Render (sin barra final y sin /api)
VITE_API_URL=http://localhost:3000
